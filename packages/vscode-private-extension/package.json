{
  "name": "ai-engineering-framework-private",
  "displayName": "AI Engineering Framework",
  "description": "Private thin-client VS Code extension for the AI Engineering Framework that delegates proprietary orchestration to a protected backend.",
  "version": "0.2.0",
  "publisher": "private",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "copilot",
    "prompt-files",
    "chat-instructions",
    "jira",
    "angular",
    "private-extension"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onCommand:aiEngineeringFramework.checkBackend",
    "onCommand:aiEngineeringFramework.startDtoCSession",
    "onCommand:aiEngineeringFramework.openBackendContract"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiEngineeringFramework.checkBackend",
        "title": "AI Engineering Framework: Check Backend"
      },
      {
        "command": "aiEngineeringFramework.startDtoCSession",
        "title": "AI Engineering Framework: Start DtoC Backend Session"
      },
      {
        "command": "aiEngineeringFramework.openBackendContract",
        "title": "AI Engineering Framework: Open Backend Contract"
      }
    ],
    "configuration": {
      "title": "AI Engineering Framework",
      "properties": {
        "aiEngineeringFramework.backendUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base HTTPS URL for the private orchestration backend."
        },
        "aiEngineeringFramework.projectId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional private project identifier used by the backend."
        },
        "aiEngineeringFramework.healthEndpoint": {
          "type": "string",
          "default": "/health",
          "markdownDescription": "Health-check path appended to `aiEngineeringFramework.backendUrl`."
        },
        "aiEngineeringFramework.capabilitiesEndpoint": {
          "type": "string",
          "default": "/capabilities",
          "markdownDescription": "Capabilities path appended to `aiEngineeringFramework.backendUrl`."
        },
        "aiEngineeringFramework.sessionEndpoint": {
          "type": "string",
          "default": "/runtime/session",
          "markdownDescription": "Runtime session path appended to `aiEngineeringFramework.backendUrl`."
        },
        "aiEngineeringFramework.apiToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional bearer token used for authenticated backend requests."
        },
        "aiEngineeringFramework.requestTimeoutMs": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "markdownDescription": "Timeout in milliseconds for backend handshake requests."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit -p .",
    "build": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:types watch:bundle",
    "watch:types": "tsc --noEmit -w -p .",
    "watch:bundle": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-yarn --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "@types/node": "^20.19.9",
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.25.9",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  }
}
